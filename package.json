{
  "name": "watchtak",
  "version": "0.1.0",
  "description": "A Discord bot for following PlayTak games",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joel-from-nyc/WatchTak.git"
  },
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc",
    "deploy-commands": "ts-node src/deploy-commands.ts",
    "deploy-commands:production": "ts-node src/deploy-commands.ts .env.production",
    "deploy-commands:testing": "ts-node src/deploy-commands.ts .env.testing",
    "dev": "ts-node src/index.ts",
    "set-avatar": "ts-node src/scripts/set-avatar.ts",
    "start": "node dist/index.js",
    "start:production": "node dist/index.js .env.production",
    "start:testing": "node dist/index.js .env.testing",
    "test": "node -r ts-node/register --test \"src/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run build && npm test"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "tps-ninja": "^1.1.25",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.18.1",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "canvas@3.2.3": true
  }
}
