{
  "name": "discord-bot-poc",
  "version": "0.1.0",
  "description": "Discord bot for the Tak board game / PlayTak.com community - browse seeks, list games, and watch a live game in a thread.",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc",
    "deploy-commands": "ts-node src/deploy-commands.ts",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "tps-ninja": "^1.1.25",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "canvas@3.2.3": true
  }
}
