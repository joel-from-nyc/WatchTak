# Copy this file to .env and fill in real values. Never commit .env itself.

# Discord Developer Portal -> your app -> Bot -> Token
DISCORD_TOKEN=

# Discord Developer Portal -> your app -> General Information -> Application ID
DISCORD_CLIENT_ID=

# The server the bot lives in. Slash commands are registered to this server
# only, which makes command changes show up instantly. Right-click the server
# icon in Discord (with Developer Mode on) to copy its ID.
DISCORD_GUILD_ID=
