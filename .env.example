# Copy this file to .env and fill in real values. Never commit .env itself.

# From the Discord Developer Portal -> your app -> Bot -> Token
DISCORD_TOKEN=

# From the Discord Developer Portal -> your app -> General Information -> Application ID
DISCORD_CLIENT_ID=

# Optional: while testing, register slash commands to a single server (instant)
# instead of globally (takes up to an hour to propagate). Right-click your
# server icon in Discord with Developer Mode on to copy the server ID.
DISCORD_GUILD_ID=

# Port for the local webhook server that external websites/apps call into
WEBHOOK_PORT=3000

# Shared secret external callers must send so randoms on the internet can't
# post messages into your Discord server through the webhook
WEBHOOK_SECRET=change-me-to-something-random
